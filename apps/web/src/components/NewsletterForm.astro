---
const apiUrl = import.meta.env.PUBLIC_PAYLOAD_API_URL ?? 'http://localhost:3000'

interface Props {
  /** This form appears on paper (contact) and on the roast footer, so the
      palette is passed in rather than assumed. */
  tone?: 'light' | 'dark'
}

const { tone = 'light' } = Astro.props
---

<form
  class:list={['newsletter-form', `newsletter-form--${tone}`]}
  id="newsletter-form"
  data-endpoint={`${apiUrl}/api/newsletter`}
>
  <label class="newsletter-form__label" for="newsletter-email">Email address</label>

  <div class="newsletter-form__row">
    <input
      class="newsletter-form__input"
      id="newsletter-email"
      name="email"
      type="email"
      placeholder="you@example.com"
      autocomplete="email"
      required
    />
    <button class="newsletter-form__submit" type="submit">
      <span class="newsletter-form__submit-text">Join</span>
      <svg
        class="newsletter-form__arrow"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M2 8h11M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>

  <p class="newsletter-form__status" id="newsletter-form-status" role="status" aria-live="polite">
  </p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#newsletter-form')
  const status = document.querySelector<HTMLParagraphElement>('#newsletter-form-status')

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!status) return

    const endpoint = form.dataset.endpoint
    const formData = new FormData(form)
    const payload = Object.fromEntries(formData.entries())

    status.textContent = 'Subscribing…'

    try {
      const res = await fetch(endpoint ?? '', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })

      if (!res.ok) throw new Error('Request failed')

      status.textContent = "You're on the list. It is a very quiet list."
      form.reset()
    } catch {
      status.textContent = 'Something went wrong. Please try again.'
    }
  })
</script>

<style lang="scss">
  @use '../styles/variables' as vars;
  @use '../styles/mixins' as mixins;

  // An underlined field rather than a boxed one: on both grounds it reads as a
  // line on a page instead of a widget dropped onto it.
  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: vars.$spacing-unit;
    max-width: 24rem;

    &--light {
      --nf-line: #{vars.$rule-strong};
      --nf-line-active: #{vars.$ink};
      --nf-text: #{vars.$ink};
      --nf-muted: #{vars.$ink-faint};
    }

    &--dark {
      --nf-line: rgb(236 228 214 / 28%);
      --nf-line-active: #{vars.$cream};
      --nf-text: #{vars.$cream};
      --nf-muted: #{vars.$cream-soft};
    }

    &__label {
      @include mixins.visually-hidden;
    }

    &__row {
      display: flex;
      align-items: center;
      gap: vars.$spacing-unit;
      border-block-end: 1px solid var(--nf-line);
      transition: border-color 0.25s ease;

      &:focus-within {
        border-color: var(--nf-line-active);
      }
    }

    &__input {
      flex: 1;
      min-width: 0;
      padding: 0.625rem 0;
      border: 0;
      background: transparent;
      color: var(--nf-text);
      font-family: vars.$font-body;
      font-size: 0.9375rem;

      &::placeholder {
        color: var(--nf-muted);
      }

      &:focus-visible {
        outline: none;
      }
    }

    &__submit {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.5rem 0;
      border: 0;
      background: transparent;
      color: var(--nf-text);
      cursor: pointer;
      @include mixins.eyebrow;
      color: var(--nf-text);

      &:hover .newsletter-form__arrow,
      &:focus-visible .newsletter-form__arrow {
        transform: translateX(3px);
      }
    }

    &__arrow {
      width: 1rem;
      height: 1rem;
      transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }

    &__status {
      min-height: 1.25em;
      margin: 0;
      font-size: 0.8125rem;
      color: var(--nf-muted);
    }
  }
</style>
