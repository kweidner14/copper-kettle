---
const apiUrl = import.meta.env.PUBLIC_PAYLOAD_API_URL ?? 'http://localhost:3000'
---

{/* Name, email and a submit button is also the shape of a sign-up form, so
    password managers offered to save a "login" here. The autocomplete tokens
    say what the fields really are, so browser autofill still fills them, and
    the ignore attributes (1Password, LastPass, Bitwarden) stop the prompt. */}
<form class="contact-form" id="contact-form" data-endpoint={`${apiUrl}/api/contact`}>
  <div class="contact-form__field">
    <label class="contact-form__label" for="contact-name">Name</label>
    <input
      class="contact-form__input"
      id="contact-name"
      name="name"
      type="text"
      autocomplete="name"
      data-1p-ignore
      data-lpignore="true"
      data-bwignore
      required
    />
  </div>

  <div class="contact-form__field">
    <label class="contact-form__label" for="contact-email">Email</label>
    <input
      class="contact-form__input"
      id="contact-email"
      name="email"
      type="email"
      autocomplete="email"
      data-1p-ignore
      data-lpignore="true"
      data-bwignore
      required
    />
  </div>

  <div class="contact-form__field">
    <label class="contact-form__label" for="contact-message">Message</label>
    <textarea class="contact-form__textarea" id="contact-message" name="message" rows="5" required
    ></textarea>
  </div>

  <button class="contact-form__submit" type="submit">Send message</button>

  <p class="contact-form__status" id="contact-form-status" role="status" aria-live="polite"></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form')
  const status = document.querySelector<HTMLParagraphElement>('#contact-form-status')

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!status) return

    const endpoint = form.dataset.endpoint
    const formData = new FormData(form)
    const payload = Object.fromEntries(formData.entries())

    status.textContent = 'Sending…'

    try {
      const res = await fetch(endpoint ?? '', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })

      if (!res.ok) throw new Error('Request failed')

      status.textContent = 'Sent. It is sitting in the CMS now, feeling important.'
      form.reset()
    } catch {
      status.textContent = 'Something went wrong. Please try again.'
    }
  })
</script>


<style lang="scss">
  @use '../styles/mixins' as mixins;
  @use '../styles/variables' as vars;

  .contact-form {
    display: grid;
    gap: vars.$spacing-unit * 2.5;

    &__field {
      display: grid;
      gap: 0.4375rem;
    }

    &__label {
      @include mixins.eyebrow;
    }

    &__input,
    &__textarea {
      @include mixins.field;
    }

    &__textarea {
      resize: vertical;
      min-height: 8rem;
    }

    &__submit {
      @include mixins.button-solid;
      justify-self: start;
    }

    &__status {
      min-height: 1.25em;
      margin: 0;
      font-size: 0.875rem;
      color: var(--ink-faint);
    }
  }
</style>
