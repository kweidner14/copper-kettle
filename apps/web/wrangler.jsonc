{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "copper-kettle",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Non-secret config lives here so it is committed and identical across
  // environments. The Storefront token is a *secret* and must never appear
  // in this file — see .dev.vars.example.
  "vars": {
    "SHOPIFY_STORE_DOMAIN": "copper-kettle-im1ju9t1.myshopify.com",
    "SHOPIFY_STOREFRONT_API_VERSION": "2026-04",
    // Not a secret: the demo banner and /checkout print it for every visitor.
    // It must match the password page in Shopify admin (Online Store ->
    // Preferences). Remove it once the store leaves the development plan.
    "SHOPIFY_STORE_PASSWORD": "coffee"
    // Add "SHOPIFY_TEST_CARD": "1" here once Shopify admin -> Settings ->
    // Payments has the Bogus Gateway (test mode) on. /checkout then tells
    // visitors which card to use.
  },

  "observability": { "enabled": true }
}
