---
// Content pages come from Payload at build time, so they stay static even
// though the project now defaults to SSR for the Shopify-backed routes.
export const prerender = true

import Layout from '../layouts/Layout.astro'
import RichText from '../components/RichText.astro'
import { getPage } from '../lib/api'

const page = await getPage('about')

const title = page?.seo?.metaTitle || page?.title || 'About'
const description = page?.seo?.metaDescription || 'About us.'
---

<Layout title={title} description={description}>
  <section class="page-content" data-reveal>
    <div class="page-content__inner">
      <h1 class="page-content__title">{page?.title ?? 'About'}</h1>
      {/* Setup hint for whoever is running this locally; never shipped. */}
      {!page && import.meta.env.DEV && (
        <p class="page-content__hint">
          No "about" page found in Payload yet — create a Page with slug <code>about</code>.
        </p>
      )}
      {page?.content && <RichText content={page.content} />}
    </div>
  </section>
</Layout>


<style lang="scss">
  @use '../styles/mixins' as mixins;
  @use '../styles/variables' as vars;

  // Shared shape for the three Payload-backed content pages: a wide masthead
  // rule, then a single measure-width column. Long-form reading, not layout.
  .page-content {
    padding-block: vars.$spacing-unit * 7 vars.$spacing-unit * 10;

    &__inner {
      @include mixins.container;
      max-width: 46rem;
    }

    &__title {
      font-size: vars.$step-1;
      margin: 0 0 vars.$spacing-unit * 4;
      padding-block-end: vars.$spacing-unit * 2;
      border-block-end: 1px solid var(--ink);
    }

    &__hint {
      color: var(--ink-faint);
      font-size: 0.9375rem;

      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.875em;
        background: var(--paper-sunk);
        padding: 0.1em 0.35em;
      }
    }

    // Payload rich text arrives as .rich-text from the RichText component, so
    // the prose rules reach across the component boundary. Constrained to the
    // measure rather than the 46rem container: the masthead wants the width,
    // the reading column does not, and full-width body copy runs to about 90
    // characters a line.
    :global(.rich-text) {
      max-width: vars.$measure;
      font-size: 1.0625rem;
      color: var(--ink);
    }

    :global(.rich-text p) {
      margin-block: 0 1.15em;
    }

    :global(.rich-text h2) {
      font-size: 1.5rem;
      margin-block: 2em 0.5em;
    }

    :global(.rich-text h3) {
      font-size: 1.1875rem;
      margin-block: 1.75em 0.4em;
    }

    :global(.rich-text h2:first-child),
    :global(.rich-text h3:first-child) {
      margin-block-start: 0;
    }

    :global(.rich-text a) {
      color: var(--copper);
      text-underline-offset: 3px;
    }

    :global(.rich-text blockquote) {
      margin-inline: 0;
      padding-inline-start: 1.25rem;
      border-inline-start: 2px solid var(--copper);
      color: var(--ink-soft);
    }
  }
</style>
