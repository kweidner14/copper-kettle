---
const year = new Date().getFullYear()

const socialLinks = [
  { href: 'https://instagram.com', label: 'Instagram' },
  { href: 'https://twitter.com', label: 'Twitter / X' },
]
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__copyright">&copy; {year} Starter. All rights reserved.</p>

    <nav class="site-footer__social" aria-label="Social media">
      <ul class="site-footer__social-list">
        {
          socialLinks.map((link) => (
            <li class="site-footer__social-item">
              <a href={link.href} class="site-footer__social-link" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="site-footer__legal" aria-label="Legal">
      <a href="/privacy-policy" class="site-footer__legal-link">Privacy Policy</a>
    </nav>
  </div>
</footer>

<style lang="scss">
  @use '../styles/variables' as vars;
  @use '../styles/mixins' as mixins;

  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: vars.$spacing-unit * 4;

    &__inner {
      @include mixins.container;
      display: flex;
      flex-direction: column;
      gap: vars.$spacing-unit * 2;

      @include mixins.respond-to(md) {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }
    }

    &__copyright {
      margin: 0;
      color: var(--color-text-muted);
      font-size: 0.875rem;
    }

    &__social-list {
      display: flex;
      list-style: none;
      margin: 0;
      padding: 0;
      gap: vars.$spacing-unit * 2;
    }

    &__social-link,
    &__legal-link {
      text-decoration: none;
      color: var(--color-text-muted);
      font-size: 0.875rem;

      &:hover,
      &:focus-visible {
        color: var(--color-text);
      }
    }
  }
</style>
