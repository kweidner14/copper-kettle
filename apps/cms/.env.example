# Postgres connection string (Railway provides this automatically when you attach a Postgres plugin).
# For quick local dev without standing up Postgres, use a `file:` URI instead
# (e.g. file:./dev.db) — payload.config.ts switches to SQLite automatically
# whenever DATABASE_URI starts with "file:". Production should always use Postgres.
DATABASE_URI=postgres://user:password@localhost:5432/payload

# Long random string used to sign Payload's auth tokens
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public URL this Payload instance is served from (used for absolute URLs, CORS, etc.)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API (your Astro site, local dev, etc.)
CORS_ORIGINS=http://localhost:4321

# S3-compatible storage (Cloudflare R2). R2 endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=copper-kettle-media
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Public base URL media is served from (R2 custom domain or public bucket URL)
S3_PUBLIC_URL=https://media.example.com

# Deploy hook Astro's host calls to trigger a rebuild on publish (e.g. Cloudflare Pages deploy hook URL)
REBUILD_WEBHOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/replace-me

