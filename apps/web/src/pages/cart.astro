---
import Layout from '../layouts/Layout.astro'
import { fixedImage } from '../lib/shopify/image'
import { formatMoney } from '../lib/shopify/money'
import { variantLabel } from '../lib/shopify/variants'
import { resolveCart } from '../lib/shopify/cart'
import { formatWeight, totalGrams } from '../lib/shopify/weight'

/**
 * The cart without JavaScript.
 *
 * The drawer is the primary UI, but it only exists once the island hydrates.
 * This page is where the endpoints' 303 lands, so an add, a quantity change and
 * a checkout handoff all still work with scripting off — each control here is a
 * real form posting to the same endpoints the drawer calls.
 */
const cart = await resolveCart(Astro)
const lines = cart?.lines.nodes ?? []
// Populated by the endpoints' 303 for both userErrors and warnings.
const notice = Astro.url.searchParams.get('notice')

// Same normalisation the drawer uses: this catalog stores weights in both
// OUNCES and POUNDS, so raw values cannot be summed.
const weightLabel = formatWeight(
  totalGrams(
    lines.map((line) => ({
      weight: line.merchandise.weight,
      weightUnit: line.merchandise.weightUnit,
      quantity: line.quantity,
    })),
  ),
)
---

<Layout title="Your cart" description="Review the items in your cart." noindex>
  <section class="cart-page">
    <div class="cart-page__inner">
      <h1 class="cart-page__title">Your cart</h1>

      {notice && <p class="cart-page__notice" role="status">{notice}</p>}

      {
        lines.length === 0 ? (
          <p class="cart-page__empty">
            Your cart is empty, which is exactly how much coffee we were going to send you
            anyway. <a href="/products">Browse the shop</a> and fill it with things that will
            never arrive.
          </p>
        ) : (
          <>
            <ul class="cart-page__lines" role="list">
              {lines.map((line) => (
                <li class="cart-row">
                  {line.merchandise.image ? (
                    <img
                      class="cart-row__image"
                      {...fixedImage(line.merchandise.image, 80)}
                      alt={line.merchandise.image.altText ?? line.merchandise.product.title}
                      width="80"
                      height="80"
                      loading="lazy"
                    />
                  ) : (
                    <div class="cart-row__image cart-row__image--placeholder" aria-hidden="true" />
                  )}

                  <div class="cart-row__body">
                    <a
                      class="cart-row__title"
                      href={`/products/${line.merchandise.product.handle}`}
                    >
                      {line.merchandise.product.title}
                    </a>

                    {variantLabel(line.merchandise.selectedOptions) && (
                      <p class="cart-row__options">
                        {variantLabel(line.merchandise.selectedOptions)}
                      </p>
                    )}

                    <div class="cart-row__controls">
                      {/* Each control is its own form so the page needs no JS.
                          Quantity 0 is what the remove button submits. */}
                      <form method="post" action="/api/cart/update" class="cart-row__form">
                        <input type="hidden" name="lineId" value={line.id} />
                        <label class="visually-hidden" for={`qty-${line.id}`}>
                          Quantity for {line.merchandise.product.title}
                        </label>
                        <input
                          id={`qty-${line.id}`}
                          class="cart-row__qty"
                          type="number"
                          name="quantity"
                          value={line.quantity}
                          min="0"
                          max="999"
                        />
                        <button class="cart-row__update" type="submit">
                          Update
                        </button>
                      </form>

                      <form method="post" action="/api/cart/update" class="cart-row__form">
                        <input type="hidden" name="lineId" value={line.id} />
                        <input type="hidden" name="quantity" value="0" />
                        <button class="cart-row__remove" type="submit">
                          Remove
                        </button>
                      </form>
                    </div>
                  </div>

                  <span class="cart-row__price">{formatMoney(line.cost.totalAmount)}</span>
                </li>
              ))}
            </ul>

            <footer class="cart-page__summary">
              <div class="cart-page__row">
                <span>Subtotal</span>
                <span>{formatMoney(cart!.cost.subtotalAmount)}</span>
              </div>

              {weightLabel && (
                <div class="cart-page__row cart-page__row--muted">
                  <span>Total weight</span>
                  <span>{weightLabel}</span>
                </div>
              )}

              <p class="cart-page__note">Shipping and taxes are calculated at checkout.</p>

              <a class="cart-page__checkout" href="/checkout" rel="nofollow">
                Checkout
              </a>
            </footer>
          </>
        )
      }
    </div>
  </section>
</Layout>


<style lang="scss">
  @use '../styles/mixins' as mixins;
  @use '../styles/variables' as vars;

  .visually-hidden {
    @include mixins.visually-hidden;
  }

  .cart-page {
    padding-block: vars.$spacing-unit * 7 vars.$spacing-unit * 10;

    &__inner {
      @include mixins.container;
      max-width: 56rem;
    }

    &__title {
      font-size: vars.$step-1;
      margin: 0 0 vars.$spacing-unit * 4;
      padding-block-end: vars.$spacing-unit * 2;
      border-block-end: 1px solid var(--ink);
    }

    &__notice {
      padding: 0.875rem 1rem;
      margin-block-end: vars.$spacing-unit * 3;
      border-inline-start: 2px solid var(--copper);
      background: var(--paper-sunk);
      font-size: 0.9375rem;
    }

    &__empty {
      color: var(--ink-soft);

      a {
        color: var(--copper);
        text-underline-offset: 3px;
      }
    }

    &__lines {
      display: grid;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    &__summary {
      display: grid;
      gap: 0.625rem;
      justify-items: end;
      margin-block-start: vars.$spacing-unit * 4;
    }

    &__row {
      display: flex;
      justify-content: space-between;
      gap: vars.$spacing-unit * 4;
      min-width: 16rem;
      font-variant-numeric: tabular-nums;

      &--muted {
        @include mixins.eyebrow;
      }
    }

    &__note {
      margin: 0.25rem 0 0.75rem;
      color: var(--ink-faint);
      font-size: 0.8125rem;
    }

    &__checkout {
      @include mixins.button-solid;
    }
  }

  .cart-row {
    display: grid;
    // minmax(0, 1fr), not 1fr: the quantity form's min-content width otherwise
    // pushes the price column off a small phone.
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: vars.$spacing-unit * 2;

    @include mixins.respond-to(sm) {
      grid-template-columns: 6rem minmax(0, 1fr) auto;
    }
    padding-block: vars.$spacing-unit * 3;
    border-block-end: 1px solid var(--rule);

    &__image {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      background: var(--paper-sunk);

      &--placeholder {
        background: var(--paper-sunk);
      }
    }

    &__body {
      display: grid;
      gap: 0.25rem;
      align-content: start;
    }

    &__title {
      font-family: vars.$font-display;
      font-size: 1.125rem;
      color: inherit;
      text-decoration: none;

      &:hover,
      &:focus-visible {
        color: var(--copper);
      }
    }

    &__options {
      margin: 0;
      @include mixins.eyebrow;
    }

    &__controls {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: vars.$spacing-unit * 2;
      margin-block-start: 0.625rem;
    }

    &__form {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      margin: 0;
    }

    &__qty {
      width: 3.5rem;
      padding: 0.375rem 0.5rem;
      border: 1px solid var(--rule-strong);
      border-radius: 0;
      background: var(--paper-raised);
      color: var(--ink);
      font-family: vars.$font-body;
      font-size: 0.875rem;
      font-variant-numeric: tabular-nums;

      &:focus-visible {
        outline: none;
        border-color: var(--ink);
      }
    }

    &__update,
    &__remove {
      border: 0;
      background: transparent;
      padding: 0;
      color: var(--ink-faint);
      font-family: vars.$font-body;
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;

      &:hover,
      &:focus-visible {
        color: var(--ink);
      }
    }

    &__remove:hover,
    &__remove:focus-visible {
      color: var(--critical);
    }

    &__price {
      font-size: 1rem;
      font-variant-numeric: tabular-nums;
    }
  }
</style>
