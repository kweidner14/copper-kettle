---
import type { PageInfo } from '../../lib/shopify/models'

interface Props {
  pageInfo: PageInfo
  /** Path to link back to, e.g. "/products" or "/collections/coffee". */
  basePath: string
}

const { pageInfo, basePath } = Astro.props

// Cursor pagination has no page numbers to link — the API only ever hands back
// the edges of the window it just returned.
const previousHref =
  pageInfo.hasPreviousPage && pageInfo.startCursor
    ? `${basePath}?before=${encodeURIComponent(pageInfo.startCursor)}`
    : null

const nextHref =
  pageInfo.hasNextPage && pageInfo.endCursor
    ? `${basePath}?after=${encodeURIComponent(pageInfo.endCursor)}`
    : null
---

{
  (previousHref || nextHref) && (
    <nav class="pagination" aria-label="Pagination">
      {previousHref ? (
        <a class="pagination__link" href={previousHref} rel="prev">
          &larr; Previous
        </a>
      ) : (
        <span class="pagination__link pagination__link--disabled">&larr; Previous</span>
      )}

      {nextHref ? (
        <a class="pagination__link" href={nextHref} rel="next">
          Next &rarr;
        </a>
      ) : (
        <span class="pagination__link pagination__link--disabled">Next &rarr;</span>
      )}
    </nav>
  )
}

<style lang="scss">
  @use '../../styles/variables' as vars;

  .pagination {
    display: flex;
    justify-content: space-between;
    gap: vars.$spacing-unit * 2;
    margin-block-start: vars.$spacing-unit * 5;

    &__link {
      padding: 0.5rem 0.875rem;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      color: inherit;
      text-decoration: none;

      &--disabled {
        color: var(--color-text-muted);
        opacity: 0.4;
      }
    }
  }
</style>
