---
// Content pages come from Payload at build time, so they stay static even
// though the project now defaults to SSR for the Shopify-backed routes.
export const prerender = true

import Layout from '../layouts/Layout.astro'
import ContactForm from '../components/ContactForm.astro'

// Deliberately, obviously fake. The address cannot belong to anyone, and the
// emails use .example, a domain reserved so that it can never receive mail.
// The one real row points at the studio that built this.
const details: { term: string; value: string; href?: string }[] = [
  { term: 'Roastery', value: '404 Not Found Lane, Denver, CO' },
  { term: 'Hours', value: 'Closed. Consistently, reliably closed.' },
  { term: 'Wholesale', value: 'wholesale@copperkettle.example (it bounces)' },
  { term: 'Press', value: 'press@copperkettle.example (so does this one)' },
  { term: 'Actual humans', value: 'CopperFox Labs', href: 'https://copperfoxlabs.com' },
]
---

<Layout
  title="Contact"
  description="Contact a coffee roaster that does not exist. The form works anyway."
>
  <section class="contact">
    <div class="contact__inner">
      <header class="contact__head">
        <p class="contact__eyebrow">Say hello</p>
        <h1 class="contact__title">Talk to the roastery that isn't</h1>
        <p class="contact__lede">
          Questions about a coffee that does not exist, a wholesale account for a business
          that does not exist, or an order that is definitely not on its way. The form works,
          though. Messages really do land in the CMS, which is more than can be said for the
          coffee.
        </p>
      </header>

      <div class="contact__layout">
        <div class="contact__form">
          <ContactForm />
        </div>

        <aside class="contact__aside">
          <h2 class="contact__aside-title">Find us (you won't)</h2>
          <dl class="contact__details">
            {
              details.map((row) => (
                <div class="contact__detail">
                  <dt>{row.term}</dt>
                  <dd>{row.href ? <a href={row.href}>{row.value}</a> : row.value}</dd>
                </div>
              ))
            }
          </dl>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style lang="scss">
  @use '../styles/mixins' as mixins;
  @use '../styles/variables' as vars;

  .contact {
    padding-block: vars.$spacing-unit * 7 vars.$spacing-unit * 10;

    &__inner {
      @include mixins.container;
    }

    &__head {
      max-width: 46rem;
      margin-block-end: vars.$spacing-unit * 5;
      padding-block-end: vars.$spacing-unit * 2;
      border-block-end: 1px solid var(--ink);
    }

    &__eyebrow {
      @include mixins.eyebrow;
      margin: 0 0 vars.$spacing-unit * 2;
    }

    &__title {
      font-size: vars.$step-1;
      margin: 0 0 vars.$spacing-unit * 2;
    }

    &__lede {
      max-width: vars.$measure;
      margin: 0;
      color: var(--ink-soft);
      font-size: 1.0625rem;
    }

    &__layout {
      display: grid;
      gap: vars.$spacing-unit * 6;

      @include mixins.respond-to(lg) {
        grid-template-columns: 1.3fr 1fr;
        gap: vars.$spacing-unit * 9;
        align-items: start;
      }
    }

    &__aside-title {
      @include mixins.eyebrow;
      margin: 0 0 vars.$spacing-unit * 2;
    }

    &__details {
      margin: 0;
      border-block-start: 1px solid var(--rule);
    }

    &__detail {
      display: grid;
      gap: 0.125rem;
      padding-block: 0.875rem;
      border-block-end: 1px solid var(--rule);

      dt {
        @include mixins.eyebrow;
        font-size: 0.6875rem;
      }

      dd {
        margin: 0;
        font-size: 0.9375rem;

        a {
          @include mixins.rule-link(vars.$copper);
        }
      }
    }
  }
</style>
