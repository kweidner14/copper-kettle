---
import type { OptionState } from '../../lib/shopify/variants'

interface Props {
  options: OptionState[]
}

const { options } = Astro.props
---

{/* Renders nothing for a product with no real options — the caller does not need to branch. */}
{
  options.length > 0 && (
    <div class="variant-picker">
      {options.map((option) => (
        <fieldset class="variant-picker__group">
          <legend class="variant-picker__legend">
            <span class="variant-picker__name">{option.name}</span>
            <span class="variant-picker__chosen">
              {option.values.find((value) => value.selected)?.value}
            </span>
          </legend>

          <ul class="variant-picker__values" role="list">
            {option.values.map((value) => (
              <li>
                {value.exists ? (
                  /*
                   * Exists but sold out stays clickable: the customer should be
                   * able to land on it and see the stock message, then change a
                   * different dimension. Only genuinely non-existent
                   * combinations are dead.
                   */
                  <a
                    class:list={[
                      'variant-picker__value',
                      value.selected && 'variant-picker__value--selected',
                      !value.available && 'variant-picker__value--unavailable',
                    ]}
                    href={value.href}
                    aria-current={value.selected ? 'true' : undefined}
                    rel="nofollow"
                  >
                    {value.swatchColor && (
                      <span
                        class="variant-picker__swatch"
                        style={`--swatch: ${value.swatchColor}`}
                        aria-hidden="true"
                      />
                    )}
                    {value.value}
                    {!value.available && <span class="visually-hidden"> (sold out)</span>}
                  </a>
                ) : (
                  <span
                    class="variant-picker__value variant-picker__value--disabled"
                    aria-disabled="true"
                  >
                    {value.value}
                    <span class="visually-hidden"> (unavailable in this combination)</span>
                  </span>
                )}
              </li>
            ))}
          </ul>
        </fieldset>
      ))}
    </div>
  )
}

<style lang="scss">
  @use '../../styles/mixins' as mixins;
  @use '../../styles/variables' as vars;

  .visually-hidden {
    @include mixins.visually-hidden;
  }

  .variant-picker {
    display: grid;
    gap: vars.$spacing-unit * 3;

    &__group {
      margin: 0;
      padding: 0;
      border: 0;
    }

    // The legend carries the option name *and* the current choice, so the
    // selection is readable without decoding which chip is highlighted.
    &__legend {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: vars.$spacing-unit;
      width: 100%;
      padding: 0;
      margin-block-end: vars.$spacing-unit * 1.5;
    }

    &__name {
      @include mixins.eyebrow;
    }

    &__chosen {
      font-family: vars.$font-display;
      font-size: 0.9375rem;
      color: var(--ink);
    }

    &__values {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    // Square chips with a hairline. Selection is a filled espresso block rather
    // than a tinted border, so the current choice survives a squint test.
    &__value {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5625rem 1rem;
      border: 1px solid var(--rule-strong);
      border-radius: 0;
      background: transparent;
      color: var(--ink-soft);
      font-size: 0.875rem;
      text-decoration: none;
      transition:
        border-color 0.2s ease,
        color 0.2s ease,
        background-color 0.2s ease;

      &:hover,
      &:focus-visible {
        border-color: var(--ink);
        color: var(--ink);
      }

      &--selected {
        border-color: var(--ink);
        background: var(--ink);
        color: var(--paper);

        &:hover,
        &:focus-visible {
          color: var(--paper);
        }
      }

      // In stock elsewhere, but this exact variant is out. Still reachable, so
      // it stays legible — just struck through.
      &--unavailable {
        color: var(--ink-faint);
        text-decoration: line-through;
        text-decoration-thickness: 1px;
      }

      // The combination does not exist at all. Not a link, and visibly inert.
      &--disabled {
        border-style: dashed;
        border-color: var(--rule);
        color: var(--ink-faint);
        cursor: not-allowed;
        opacity: 0.6;
      }
    }

    &__swatch {
      width: 0.875rem;
      height: 0.875rem;
      border: 1px solid rgb(25 20 16 / 25%);
      background: var(--swatch, transparent);
    }
  }
</style>
