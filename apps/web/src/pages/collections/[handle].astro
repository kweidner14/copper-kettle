---
import Layout from '../../layouts/Layout.astro'
import Pagination from '../../components/shop/Pagination.astro'
import ProductCard from '../../components/shop/ProductCard.astro'
import { createShopifyApi, paginationFromUrl } from '../../lib/shopify/api'

const { handle } = Astro.params

const shopify = createShopifyApi(Astro)
const collection = handle
  ? await shopify.getCollection(handle, paginationFromUrl(Astro.url))
  : null

if (!collection) {
  return Astro.rewrite('/404')
}

const products = collection.products.nodes
const title = collection.seo?.title || collection.title
const description = collection.seo?.description || `${collection.title} from Copper Kettle.`
---

<Layout title={title} description={description} ogImage={collection.image?.url}>
  <section class="collection">
    <div class="collection__inner">
      <header class="collection__header">
        <nav class="collection__breadcrumb" aria-label="Breadcrumb">
          <a href="/collections">Collections</a>
          <span aria-hidden="true">/</span>
          <span>{collection.title}</span>
        </nav>

        <h1 class="collection__title">{collection.title}</h1>

        {
          collection.descriptionHtml && (
            <div class="collection__description" set:html={collection.descriptionHtml} />
          )
        }
      </header>

      {
        products.length === 0 ? (
          <p class="collection__empty">Nothing in this collection yet.</p>
        ) : (
          <ul class="collection__grid" role="list">
            {products.map((product, index) => (
              <li>
                <ProductCard product={product} eager={index < 4} />
              </li>
            ))}
          </ul>
        )
      }

      <Pagination pageInfo={collection.products.pageInfo} basePath={`/collections/${collection.handle}`} />
    </div>
  </section>
</Layout>


<style lang="scss">
  @use '../../styles/mixins' as mixins;
  @use '../../styles/variables' as vars;

  .collection {
    padding-block: vars.$spacing-unit * 4 vars.$spacing-unit * 10;

    &__inner {
      @include mixins.container;
    }

    &__header {
      max-width: 46rem;
      margin-block-end: vars.$spacing-unit * 5;
    }

    &__breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-block-end: vars.$spacing-unit * 3;
      @include mixins.eyebrow;

      a {
        @include mixins.rule-link(vars.$ink-faint);
      }
    }

    &__title {
      font-size: vars.$step-1;
      margin: 0 0 vars.$spacing-unit * 2;
    }

    &__description {
      max-width: vars.$measure;
      color: var(--ink-soft);
    }

    &__empty {
      color: var(--ink-soft);
    }

    &__grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
      gap: vars.$spacing-unit * 5 vars.$spacing-unit * 4;
      margin: 0;
      padding: 0;
      list-style: none;
      padding-block-start: vars.$spacing-unit * 3;
      border-block-start: 1px solid var(--ink);
    }
  }
</style>
