---
import type { PageInfo } from '../../lib/shopify/models'

interface Props {
  pageInfo: PageInfo
  /** Path to link back to, e.g. "/products" or "/collections/coffee". */
  basePath: string
  /** Query parameters to carry onto every page, such as the sort and search term. */
  params?: Record<string, string>
}

const { pageInfo, basePath, params = {} } = Astro.props

// A cursor only means something within the order and query that produced it,
// so every page link repeats them.
const pageHref = (cursorParam: 'before' | 'after', cursor: string) => {
  const search = new URLSearchParams(params)
  search.set(cursorParam, cursor)
  return `${basePath}?${search}`
}

// Cursor pagination has no page numbers to link — the API only ever hands back
// the edges of the window it just returned.
const previousHref =
  pageInfo.hasPreviousPage && pageInfo.startCursor
    ? pageHref('before', pageInfo.startCursor)
    : null

const nextHref =
  pageInfo.hasNextPage && pageInfo.endCursor ? pageHref('after', pageInfo.endCursor) : null
---

{
  (previousHref || nextHref) && (
    <nav class="pagination" aria-label="Pagination">
      {previousHref ? (
        <a class="pagination__link" href={previousHref} rel="prev">
          &larr; Previous
        </a>
      ) : (
        <span class="pagination__link pagination__link--disabled">&larr; Previous</span>
      )}

      {nextHref ? (
        <a class="pagination__link" href={nextHref} rel="next">
          Next &rarr;
        </a>
      ) : (
        <span class="pagination__link pagination__link--disabled">Next &rarr;</span>
      )}
    </nav>
  )
}

<style lang="scss">
  @use '../../styles/variables' as vars;
  @use '../../styles/mixins' as mixins;

  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: vars.$spacing-unit * 2;
    margin-block-start: vars.$spacing-unit * 8;
    padding-block-start: vars.$spacing-unit * 3;
    border-block-start: 1px solid var(--rule);

    &__link {
      @include mixins.eyebrow;
      @include mixins.rule-link(vars.$ink);
      font-size: 0.75rem;
    }

    // Rendered as a span, not an anchor, at the ends of the cursor window.
    // Kept visible but inert so Previous/Next stay pinned to their edges.
    &__link--disabled {
      color: var(--ink-faint);
      pointer-events: none;

      &::after {
        display: none;
      }
    }
  }
</style>
