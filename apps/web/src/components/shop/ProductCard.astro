---
import Price from './Price.astro'
import type { ProductCard } from '../../lib/shopify/models'

interface Props {
  product: ProductCard
  /** Eager-load the first row so the grid does not pop in on LCP. */
  eager?: boolean
  /** Index in the listing, rendered as a catalogue number. */
  index?: number
}

const { product, eager = false, index } = Astro.props

const image = product.featuredImage
const minPrice = product.priceRange.minVariantPrice
const maxPrice = product.priceRange.maxVariantPrice
const compareAt = product.compareAtPriceRange.minVariantPrice
const variantCount = product.variantsCount?.count ?? 0

const catalogueNumber = typeof index === 'number' ? String(index + 1).padStart(2, '0') : null
---

<article class:list={['product-card', !product.availableForSale && 'is-sold-out']}>
  <a class="product-card__link" href={`/products/${product.handle}`}>
    <div class="product-card__media">
      {
        image ? (
          <img
            class="product-card__image"
            src={image.url}
            alt={image.altText ?? product.title}
            width={image.width ?? 600}
            height={image.height ?? 600}
            loading={eager ? 'eager' : 'lazy'}
            decoding={eager ? 'sync' : 'async'}
          />
        ) : (
          <div class="product-card__image product-card__image--placeholder" aria-hidden="true" />
        )
      }

      {catalogueNumber && <span class="product-card__number">{catalogueNumber}</span>}
      {!product.availableForSale && <span class="product-card__flag">Sold out</span>}
    </div>

    <div class="product-card__body">
      <h3 class="product-card__title">{product.title}</h3>

      <div class="product-card__meta">
        <Price
          class="product-card__price"
          price={minPrice}
          maxPrice={maxPrice}
          compareAtPrice={compareAt}
        />
        {variantCount > 1 && <span class="product-card__variants">{variantCount} options</span>}
      </div>
    </div>
  </a>
</article>

<style lang="scss">
  @use '../../styles/variables' as vars;
  @use '../../styles/mixins' as mixins;

  .product-card {
    height: 100%;

    &__link {
      display: grid;
      grid-template-rows: auto 1fr;
      gap: vars.$spacing-unit * 2;
      height: 100%;
      color: inherit;
      text-decoration: none;
    }

    &__media {
      position: relative;
      overflow: hidden;
      // Portrait crop. Packaging shots have vertical subjects, and a taller
      // frame gives the bag room instead of cropping it to a square.
      aspect-ratio: 4 / 5;
      background: var(--paper-sunk);
    }

    &__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      // Very slow, very small. Enough to feel alive on hover without the
      // "storefront card" bounce.
      transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    }

    &__link:hover &__image,
    &__link:focus-visible &__image {
      transform: scale(1.035);
    }

    // Catalogue number, set into the image corner like a plate reference.
    &__number {
      position: absolute;
      inset-block-start: 0.75rem;
      inset-inline-start: 0.75rem;
      @include mixins.eyebrow;
      font-size: 0.625rem;
      color: var(--cream);
      mix-blend-mode: difference;
    }

    &__flag {
      position: absolute;
      inset-block-end: 0;
      inset-inline: 0;
      padding: 0.5rem 0.75rem;
      background: var(--roast);
      color: var(--cream);
      @include mixins.eyebrow;
      color: var(--cream);
      text-align: center;
    }

    &__body {
      display: grid;
      align-content: start;
      gap: 0.375rem;
      padding-block-end: vars.$spacing-unit;
      border-block-end: 1px solid var(--rule);
      transition: border-color 0.3s ease;
    }

    &__link:hover &__body,
    &__link:focus-visible &__body {
      border-color: var(--ink);
    }

    &__title {
      margin: 0;
      font-family: vars.$font-display;
      font-size: 1.125rem;
      font-weight: 500;
      letter-spacing: -0.01em;
      line-height: 1.25;
    }

    &__meta {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: vars.$spacing-unit;
    }

    &__variants {
      @include mixins.eyebrow;
      font-size: 0.625rem;
    }

    &.is-sold-out &__image {
      opacity: 0.55;
      filter: saturate(0.5);
    }
  }
</style>
