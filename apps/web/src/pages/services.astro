---
// Content pages come from Payload at build time, so they stay static even
// though the project now defaults to SSR for the Shopify-backed routes.
export const prerender = true

import Layout from '../layouts/Layout.astro'
import RichText from '../components/RichText.astro'
import { getPage } from '../lib/api'

const page = await getPage('services')

const title = page?.seo?.metaTitle || page?.title || 'Services'
const description = page?.seo?.metaDescription || 'What we offer.'
---

<Layout title={title} description={description}>
  <section class="page-content" data-reveal>
    <div class="page-content__inner">
      <h1 class="page-content__title">{page?.title ?? 'Services'}</h1>
      {!page && (
        <p class="page-content__hint">
          No "services" page found in Payload yet — create a Page with slug <code>services</code>.
        </p>
      )}
      {page?.content && <RichText content={page.content} />}
    </div>
  </section>
</Layout>

<style lang="scss">
  @use '../styles/mixins' as mixins;
  @use '../styles/variables' as vars;

  .page-content {
    padding-block: vars.$spacing-unit * 6;

    &__inner {
      @include mixins.container;
      max-width: 42rem;
    }

    &__hint {
      color: var(--color-text-muted);
      font-size: 0.875rem;
    }
  }
</style>
