---
import { discountPercent, formatMoney, formatPriceRange, isOnSale } from '../../lib/shopify/money'
import type { Money } from '../../lib/shopify/models'

interface Props {
  price: Money
  /** Set for a range ("$18.00 – $95.00"); collapses automatically when equal to `price`. */
  maxPrice?: Money | null
  compareAtPrice?: Money | null
  class?: string
}

const { price, maxPrice = null, compareAtPrice = null, class: className } = Astro.props

const display = maxPrice ? formatPriceRange(price, maxPrice) : formatMoney(price)
const onSale = isOnSale(price, compareAtPrice)
---

<span class:list={['price', className]}>
  <span class:list={['price__amount', onSale && 'price__amount--sale']}>{display}</span>
  {
    onSale && compareAtPrice && (
      <>
        <s class="price__compare">{formatMoney(compareAtPrice)}</s>
        <span class="price__badge">{discountPercent(price, compareAtPrice)}% off</span>
      </>
    )
  }
</span>

<style lang="scss">
  @use '../../styles/variables' as vars;
  @use '../../styles/mixins' as mixins;

  .price {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-variant-numeric: tabular-nums;

    &__amount {
      font-size: 0.9375rem;
      color: var(--ink);

      // On sale the live price takes the accent; the struck original sits back.
      &--sale {
        color: var(--copper);
      }
    }

    &__compare {
      color: var(--ink-faint);
      font-size: 0.8125rem;
      text-decoration-thickness: 1px;
    }

    &__badge {
      @include mixins.eyebrow;
      font-size: 0.5625rem;
      color: var(--copper);
      border: 1px solid currentColor;
      padding: 0.125rem 0.3125rem;
    }
  }
</style>
