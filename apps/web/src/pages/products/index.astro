---
import Layout from '../../layouts/Layout.astro'
import Pagination from '../../components/shop/Pagination.astro'
import ProductCard from '../../components/shop/ProductCard.astro'
import { createShopifyApi, paginationFromUrl } from '../../lib/shopify/api'

// SSR, not prerendered: the grid shows live sold-out state. A prerendered grid
// would go stale the moment inventory moved, which is the one thing a store
// cannot be wrong about.
const shopify = createShopifyApi(Astro)
const { products, pageInfo } = await shopify.getProducts({
  ...paginationFromUrl(Astro.url),
  sortKey: 'BEST_SELLING',
})
---

<Layout
  title="Shop all coffee"
  description="Every roast, grind and size in the Copper Kettle range."
>
  <section class="catalog">
    <div class="catalog__inner">
      <header class="catalog__masthead">
        <p class="catalog__eyebrow">The catalogue</p>
        <h1 class="catalog__title">Coffee, roasted to order</h1>
        <p class="catalog__lede">
          Everything below is roasted the week it ships. Pick your roast, grind and size
          on the bag itself, rather than hunting through a dozen near-identical listings.
        </p>
      </header>

      <div class="catalog__bar">
        <p class="catalog__count">
          {products.length} {products.length === 1 ? 'product' : 'products'}
        </p>
        <p class="catalog__sort">Sorted by popularity</p>
      </div>

      {
        products.length === 0 ? (
          <p class="catalog__empty">
            No products are published to the Headless sales channel yet.
          </p>
        ) : (
          <ul class="catalog__grid" role="list">
            {products.map((product, index) => (
              <li class="catalog__item">
                <ProductCard product={product} index={index} eager={index < 3} />
              </li>
            ))}
          </ul>
        )
      }

      <Pagination pageInfo={pageInfo} basePath="/products" />
    </div>
  </section>
</Layout>

<style lang="scss">
  @use '../../styles/variables' as vars;
  @use '../../styles/mixins' as mixins;

  .catalog {
    padding-block: vars.$spacing-unit * 7 vars.$spacing-unit * 10;

    &__inner {
      @include mixins.container;
    }

    &__masthead {
      max-width: 46rem;
      margin-block-end: vars.$spacing-unit * 6;
    }

    &__eyebrow {
      @include mixins.eyebrow;
      margin: 0 0 vars.$spacing-unit * 2;
    }

    &__title {
      font-size: vars.$step-1;
      margin: 0 0 vars.$spacing-unit * 2;
    }

    &__lede {
      max-width: vars.$measure;
      margin: 0;
      color: var(--ink-soft);
      font-size: 1.0625rem;
    }

    // A hairline rail carrying the result count and the sort state. Does the
    // job a filter bar does on a theme, without the chrome.
    &__bar {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: vars.$spacing-unit * 2;
      padding-block-end: vars.$spacing-unit;
      border-block-end: 1px solid var(--ink);
      margin-block-end: vars.$spacing-unit * 4;
    }

    &__count,
    &__sort {
      @include mixins.eyebrow;
      margin: 0;
      color: var(--ink);
    }

    &__sort {
      color: var(--ink-faint);
    }

    &__grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
      gap: vars.$spacing-unit * 5 vars.$spacing-unit * 4;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    &__empty {
      padding-block: vars.$spacing-unit * 6;
      color: var(--ink-soft);
    }
  }
</style>
