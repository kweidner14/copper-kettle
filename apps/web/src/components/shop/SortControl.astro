---
import type { SortOption, SortValue } from '../../lib/shopify/sort'

interface Props {
  options: SortOption[]
  current: SortValue
  /** Other query parameters the sort must not drop, such as the search term. */
  keep?: Record<string, string>
}

const { options, current, keep = {} } = Astro.props
---

{/* A plain GET form, so sorting works with no JavaScript: pick, press Sort.
    The script below submits on change and hides the button. Submitting drops
    the pagination cursor on purpose, because a cursor from one order means
    nothing in another. */}
<form class="sort" method="get" data-sort-form>
  {Object.entries(keep).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
  <label class="sort__label" for="sort-select">Sort</label>
  <select class="sort__select" id="sort-select" name="sort">
    {
      options.map((option) => (
        <option value={option.value} selected={option.value === current}>
          {option.label}
        </option>
      ))
    }
  </select>
  <button class="sort__apply" type="submit">Sort</button>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-sort-form]').forEach((form) => {
    form.classList.add('is-enhanced')
    form.querySelector('select')?.addEventListener('change', () => form.requestSubmit())
  })
</script>

<style lang="scss">
  @use '../../styles/variables' as vars;
  @use '../../styles/mixins' as mixins;

  // Sits on the catalogue's hairline rail, so it reads as part of that line of
  // small caps rather than as a form control dropped on top of it.
  .sort {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;

    // Spoken but not shown on phones, where the rail is too narrow for the
    // count, the label and the longest option on one line. The select's own
    // value already says what it is.
    &__label {
      @include mixins.visually-hidden;

      @include mixins.respond-to(sm) {
        position: static;
        width: auto;
        height: auto;
        margin: 0;
        overflow: visible;
        clip: auto;
        white-space: normal;
        @include mixins.eyebrow;
      }
    }

    &__select {
      @include mixins.eyebrow;
      appearance: none;
      padding: 0.125rem 1.25rem 0.125rem 0;
      border: 0;
      border-block-end: 1px solid var(--rule-strong);
      border-radius: 0;
      // A chevron drawn in CSS, because appearance: none removes the native one.
      background:
        linear-gradient(45deg, transparent 50%, var(--ink) 50%) right 0.375rem center / 4px 4px
          no-repeat,
        linear-gradient(135deg, var(--ink) 50%, transparent 50%) right 0.125rem center / 4px 4px
          no-repeat;
      color: var(--ink);
      cursor: pointer;

      &:focus-visible {
        outline: 2px solid var(--copper);
        outline-offset: 3px;
      }
    }

    &__apply {
      @include mixins.eyebrow;
      padding: 0.125rem 0.5rem;
      border: 1px solid var(--rule-strong);
      background: transparent;
      color: var(--ink);
      cursor: pointer;
    }

    &.is-enhanced &__apply {
      display: none;
    }
  }
</style>
