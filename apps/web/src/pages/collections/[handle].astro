---
import Layout from '../../layouts/Layout.astro'
import Pagination from '../../components/shop/Pagination.astro'
import ProductCard from '../../components/shop/ProductCard.astro'
import SortControl from '../../components/shop/SortControl.astro'
import { createShopifyApi, paginationFromUrl } from '../../lib/shopify/api'
import { collectionSort, readSort, sortOptions } from '../../lib/shopify/sort'

const { handle } = Astro.params

// "featured" here is the merchant's own order for the collection.
const options = sortOptions('catalog')
const sort = readSort(Astro.url, options, 'featured')
const sortParams: Record<string, string> = sort === 'featured' ? {} : { sort }

const shopify = createShopifyApi(Astro)
const collection = handle
  ? await shopify.getCollection(handle, {
      ...paginationFromUrl(Astro.url),
      ...collectionSort(sort),
    })
  : null

if (!collection) {
  return Astro.rewrite('/404')
}

const products = collection.products.nodes
const title = collection.seo?.title || collection.title
const description = collection.seo?.description || `${collection.title} from Copper Kettle.`
---

<Layout title={title} description={description} ogImage={collection.image?.url}>
  <section class="collection">
    <div class="collection__inner">
      <header class="collection__header">
        <nav class="collection__breadcrumb" aria-label="Breadcrumb">
          <a href="/collections">Collections</a>
          <span aria-hidden="true">/</span>
          <span>{collection.title}</span>
        </nav>

        <h1 class="collection__title">{collection.title}</h1>

        {
          collection.descriptionHtml && (
            <div class="collection__description" set:html={collection.descriptionHtml} />
          )
        }
      </header>

      <div class="collection__bar">
        <p class="collection__count">
          {products.length} {products.length === 1 ? 'product' : 'products'}
        </p>
        <SortControl options={options} current={sort} />
      </div>

      {
        products.length === 0 ? (
          <p class="collection__empty">
            Nothing in this collection yet. Even by our standards, that is a lot of nothing.
          </p>
        ) : (
          <ul class="collection__grid" role="list">
            {products.map((product, index) => (
              <li>
                <ProductCard product={product} eager={index < 4} priority={index === 0} />
              </li>
            ))}
          </ul>
        )
      }

      <Pagination
        pageInfo={collection.products.pageInfo}
        basePath={`/collections/${collection.handle}`}
        params={sortParams}
      />
    </div>
  </section>
</Layout>


<style lang="scss">
  @use '../../styles/mixins' as mixins;
  @use '../../styles/variables' as vars;

  .collection {
    padding-block: vars.$spacing-unit * 4 vars.$spacing-unit * 10;

    &__inner {
      @include mixins.container;
    }

    &__header {
      max-width: 46rem;
      margin-block-end: vars.$spacing-unit * 5;
    }

    &__breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-block-end: vars.$spacing-unit * 3;
      @include mixins.eyebrow;

      a {
        @include mixins.rule-link(vars.$ink-faint);
      }
    }

    &__title {
      font-size: vars.$step-1;
      margin: 0 0 vars.$spacing-unit * 2;
    }

    &__description {
      max-width: vars.$measure;
      color: var(--ink-soft);
    }

    &__empty {
      color: var(--ink-soft);
    }

    // The same count-and-sort rail as the catalogue page.
    &__bar {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: vars.$spacing-unit vars.$spacing-unit * 2;
      padding-block-end: vars.$spacing-unit;
      border-block-end: 1px solid var(--ink);
      margin-block-end: vars.$spacing-unit * 4;
    }

    &__count {
      @include mixins.eyebrow;
      margin: 0;
      color: var(--ink);
    }

    &__grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
      gap: vars.$spacing-unit * 5 vars.$spacing-unit * 4;
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }
</style>
