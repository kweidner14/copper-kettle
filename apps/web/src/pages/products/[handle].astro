---
import Layout from '../../layouts/Layout.astro'
import Price from '../../components/shop/Price.astro'
import VariantPicker from '../../components/shop/VariantPicker.astro'
import { createShopifyApi } from '../../lib/shopify/api'
import { fluidImage, imageUrl } from '../../lib/shopify/image'
import { formatMoney } from '../../lib/shopify/money'
import { resolveVariantSelection } from '../../lib/shopify/variants'
import { formatWeight, variantWeightInGrams } from '../../lib/shopify/weight'

// SSR: `quantityAvailable` and `availableForSale` are read per request, so the
// page can never advertise stock the store no longer has.
const { handle } = Astro.params

const shopify = createShopifyApi(Astro)
const product = handle ? await shopify.getProduct(handle) : null

if (!product) {
  return Astro.rewrite('/404')
}

const { options, selectedVariant, selectedOptions } = resolveVariantSelection(product, Astro.url)

const heroImage = selectedVariant?.image ?? product.featuredImage

// Every image, hero included, so the visitor can always get back to the one
// they started on. A variant image is normally also a product image; the
// prepend only covers one that was attached to the variant alone.
const productImages = product.images.nodes
const galleryImages =
  heroImage && !productImages.some((image) => image.url === heroImage.url)
    ? [heroImage, ...productImages]
    : productImages

// The media column is the 1.15fr side of the lg grid; below lg it is full
// width. Thumbnails are auto-fill minmax(5rem, 1fr) tracks, so roughly 100px.
const MAIN_SIZES = '(min-width: 1320px) 625px, (min-width: 1024px) 46vw, calc(100vw - 48px)'
const THUMB_SIZES = '100px'
const THUMB_WIDTHS = [100, 200, 300]

const weightLabel = formatWeight(selectedVariant ? variantWeightInGrams(selectedVariant) : null)

const inStock = selectedVariant?.availableForSale ?? false
const remaining = selectedVariant?.quantityAvailable ?? null
const lowStock = inStock && remaining !== null && remaining > 0 && remaining <= 5

// Variant params are navigation state, not distinct pages — point every
// combination at the bare product URL so they do not compete in search.
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? ''
const canonicalUrl = `${siteUrl}/products/${product.handle}`

const title = product.seo?.title || product.title
const description =
  product.seo?.description ||
  `${product.title} from Copper Kettle. ${formatMoney(product.priceRange.minVariantPrice)}.`

// Product rich result. Describes the product, not the selected variant: every
// variant URL canonicalises to the bare product URL, so the offer is the whole
// price range rather than whichever variant happened to be selected.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  description,
  url: canonicalUrl,
  image: galleryImages.map((image) => image.url),
  brand: product.vendor ? { '@type': 'Brand', name: product.vendor } : undefined,
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: product.priceRange.minVariantPrice.currencyCode,
    lowPrice: product.priceRange.minVariantPrice.amount,
    highPrice: product.priceRange.maxVariantPrice.amount,
    offerCount: product.variants.nodes.length,
    availability: product.availableForSale
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
  },
}

// Rendered as a spec table. Built here so the markup stays a simple loop and
// empty rows never reach the DOM.
const specs = [
  selectedVariant?.sku ? { term: 'SKU', value: selectedVariant.sku } : null,
  // Normalised to grams first: this catalog stores weights in both OUNCES and
  // POUNDS on the same product.
  weightLabel ? { term: 'Shipping weight', value: weightLabel } : null,
  selectedOptions.length > 0
    ? { term: 'Selection', value: selectedOptions.map((option) => option.value).join(' / ') }
    : null,
  { term: 'Roasted', value: 'To order, in Denver, CO' },
].filter((row): row is { term: string; value: string } => row !== null)
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={heroImage ? imageUrl(heroImage, 1200) : undefined}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />

  <article class="product">
    <div class="product__inner">
      <nav class="product__breadcrumb" aria-label="Breadcrumb">
        <a href="/products">Shop all</a>
        <span aria-hidden="true">/</span>
        <span>{product.title}</span>
      </nav>

      <div class="product__layout">
        <div class="product__media">
          <div class="product__frame">
            {
              heroImage ? (
                <img
                  class="product__image"
                  {...fluidImage(heroImage, MAIN_SIZES)}
                  alt={heroImage.altText ?? product.title}
                  width={heroImage.width ?? 900}
                  height={heroImage.height ?? 900}
                  loading="eager"
                  fetchpriority="high"
                  data-gallery-main
                />
              ) : (
                <div class="product__image product__image--placeholder" aria-hidden="true" />
              )
            }
          </div>

          {/* Each thumbnail is a link to a large copy of its image, so it still
              does something without JavaScript. The script below upgrades a
              click into swapping the main frame in place, which is why each
              link also carries the main frame's src and srcset for its image. */}
          {
            heroImage && galleryImages.length > 1 && (
              <ul class="product__thumbs" role="list" aria-label="Product images">
                {galleryImages.map((image, index) => {
                  const alt = image.altText ?? product.title
                  const isCurrent = image.url === heroImage.url
                  const main = fluidImage(image, MAIN_SIZES)
                  return (
                    <li>
                      <a
                        class="product__thumb-link"
                        href={imageUrl(image, 1600)}
                        aria-current={isCurrent ? 'true' : undefined}
                        data-gallery-thumb
                        data-src={main.src}
                        data-srcset={main.srcset}
                        data-alt={alt}
                        data-width={image.width ?? 900}
                        data-height={image.height ?? 900}
                      >
                        <img
                          class="product__thumb"
                          {...fluidImage(image, THUMB_SIZES, {
                            fallbackWidth: 200,
                            widths: THUMB_WIDTHS,
                          })}
                          alt=""
                          width={image.width ?? 160}
                          height={image.height ?? 160}
                          loading="lazy"
                        />
                        <span class="sr-only">
                          Show image {index + 1} of {galleryImages.length}
                        </span>
                      </a>
                    </li>
                  )
                })}
              </ul>
            )
          }
        </div>

        <div class="product__details">
          <header class="product__head">
            {product.vendor && <p class="product__vendor">{product.vendor}</p>}
            <h1 class="product__title">{product.title}</h1>

            {
              selectedVariant ? (
                <Price
                  class="product__price"
                  price={selectedVariant.price}
                  compareAtPrice={selectedVariant.compareAtPrice}
                />
              ) : (
                <Price
                  class="product__price"
                  price={product.priceRange.minVariantPrice}
                  maxPrice={product.priceRange.maxVariantPrice}
                />
              )
            }
          </header>

          {
            product.descriptionHtml && (
              <div class="product__description" set:html={product.descriptionHtml} />
            )
          }

          <VariantPicker options={options} />

          <div class="product__buy-block">
            <p class:list={['product__stock', !inStock && 'product__stock--out']}>
              <span class="product__stock-dot" aria-hidden="true"></span>
              {!inStock && 'Sold out'}
              {inStock && lowStock && `Only ${remaining} left`}
              {inStock && !lowStock && 'In stock, ships tomorrow'}
            </p>

            {/* A real form post, not a JS-only button: with no JavaScript this
                still adds the line and redirects to /cart. src/scripts/cart.ts
                upgrades it in place and opens the drawer. The variant is
                resolved server-side, so the browser never maps options to a
                variant id. */}
            <form class="product__buy" method="post" action="/api/cart/add" data-cart-add>
              <input type="hidden" name="variantId" value={selectedVariant?.id ?? ''} />
              <input type="hidden" name="quantity" value="1" />
              <button class="product__add" type="submit" disabled={!inStock || !selectedVariant}>
                {inStock ? 'Add to cart' : 'Unavailable'}
              </button>
            </form>
          </div>

          <dl class="product__specs">
            {
              specs.map((row) => (
                <div class="product__spec">
                  <dt>{row.term}</dt>
                  <dd class="tabular">{row.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </article>
</Layout>

<script>
  // Swaps the main frame in place. Without this, each thumbnail is a plain link
  // to a large copy of the image, which is a worse experience but not a broken one.
  const main = document.querySelector<HTMLImageElement>('[data-gallery-main]')
  const thumbs = document.querySelectorAll<HTMLAnchorElement>('[data-gallery-thumb]')

  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', (event) => {
      if (!main) return
      event.preventDefault()

      // srcset first: while it is set, the browser picks from it and ignores src,
      // so changing src alone would leave the old image showing.
      if (thumb.dataset.srcset) main.srcset = thumb.dataset.srcset
      main.src = thumb.dataset.src ?? thumb.href
      main.alt = thumb.dataset.alt ?? ''
      // Kept in step with the source so the frame never reflows mid-swap.
      if (thumb.dataset.width) main.width = Number(thumb.dataset.width)
      if (thumb.dataset.height) main.height = Number(thumb.dataset.height)

      thumbs.forEach((other) => other.removeAttribute('aria-current'))
      thumb.setAttribute('aria-current', 'true')
    })
  })
</script>

<style lang="scss">
  @use '../../styles/mixins' as mixins;
  @use '../../styles/variables' as vars;

  .product {
    padding-block: vars.$spacing-unit * 4 vars.$spacing-unit * 10;

    &__inner {
      @include mixins.container;
    }

    &__breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-block-end: vars.$spacing-unit * 4;
      @include mixins.eyebrow;

      a {
        @include mixins.rule-link(vars.$ink-faint);
      }
    }

    &__layout {
      display: grid;
      gap: vars.$spacing-unit * 5;

      @include mixins.respond-to(lg) {
        // The image column is wider: the packaging is the argument on a coffee
        // site, and the buy controls need less room than they are usually given.
        grid-template-columns: 1.15fr 1fr;
        gap: vars.$spacing-unit * 9;
        align-items: start;
      }
    }

    &__media {
      display: grid;
      gap: vars.$spacing-unit * 2;

      @include mixins.respond-to(lg) {
        // Sticks while the details column scrolls past it.
        position: sticky;
        top: calc(var(--masthead-height) + #{vars.$spacing-unit * 3});
      }
    }

    &__frame {
      overflow: hidden;
      background: var(--paper-sunk);
      aspect-ratio: 4 / 5;
    }

    &__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &__thumbs {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(5rem, 1fr));
      gap: vars.$spacing-unit;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    &__thumb-link {
      display: block;
      outline-offset: 2px;
      // The current image is ringed rather than dimming the others, so every
      // thumbnail stays legible.
      box-shadow: 0 0 0 1px var(--rule);
      transition: box-shadow 0.15s ease;

      &:hover {
        box-shadow: 0 0 0 1px var(--ink-soft);
      }

      &[aria-current='true'] {
        box-shadow: 0 0 0 2px var(--copper);
      }
    }

    &__thumb {
      width: 100%;
      aspect-ratio: 1;
      height: auto;
      object-fit: cover;
      background: var(--paper-sunk);
    }

    &__details {
      display: grid;
      align-content: start;
      gap: vars.$spacing-unit * 4;

      @include mixins.respond-to(lg) {
        max-width: 30rem;
      }
    }

    &__head {
      display: grid;
      gap: vars.$spacing-unit;
      padding-block-end: vars.$spacing-unit * 3;
      border-block-end: 1px solid var(--rule);
    }

    &__vendor {
      @include mixins.eyebrow;
      margin: 0;
    }

    &__title {
      font-size: vars.$step-1;
      margin: 0;
    }

    &__price {
      font-size: 1.25rem;
    }

    &__description {
      color: var(--ink-soft);
      max-width: vars.$measure;

      :global(p) {
        margin-block: 0 0.75em;
      }

      :global(p:last-child) {
        margin-block-end: 0;
      }
    }

    &__buy-block {
      display: grid;
      gap: vars.$spacing-unit * 2;
    }

    // A dot and a line, not a coloured pill. Reads as a status note rather than
    // a badge component.
    &__stock {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin: 0;
      @include mixins.eyebrow;
      color: var(--ink-soft);

      &--out {
        color: var(--critical);
      }
    }

    &__stock-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--positive);

      .product__stock--out & {
        background: var(--critical);
      }
    }

    &__buy {
      margin: 0;
    }

    &__add {
      @include mixins.button-solid;
      width: 100%;
    }

    // Spec rows separated by hairlines. This is where a storefront theme would
    // put an accordion; a table of facts is faster to read and looks like print.
    &__specs {
      margin: 0;
      border-block-start: 1px solid var(--rule);
    }

    &__spec {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: vars.$spacing-unit * 2;
      padding-block: 0.75rem;
      border-block-end: 1px solid var(--rule);

      dt {
        @include mixins.eyebrow;
      }

      dd {
        margin: 0;
        font-size: 0.9375rem;
        text-align: right;
      }
    }
  }
</style>
