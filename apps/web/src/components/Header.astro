---
import CartDrawer from './shop/CartDrawer.svelte'
import type { Cart } from '../lib/shopify/cart'
import { publicPath } from '../lib/url'

interface Props {
  cart: Cart | null
}

const { cart } = Astro.props

const navItems = [
  { href: '/products', label: 'Shop' },
  { href: '/collections', label: 'Collections' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
]

// Marks the section the visitor is in, including nested routes like
// /products/<handle>, so the header always says where you are.
const path = publicPath(Astro.url.pathname)
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`)
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo">
      <span class="site-header__logo-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25">
          <path d="M4 10h11v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5v-5Z" stroke-linejoin="round"></path>
          <path d="M15 11.5h1.5a2.5 2.5 0 0 1 0 5H15" stroke-linecap="round"></path>
          <path d="M7.5 6.5c0-1 1-1.5 1-2.5M11.5 6.5c0-1 1-1.5 1-2.5" stroke-linecap="round"
          ></path>
        </svg>
      </span>
      <span class="site-header__logo-text">
        Copper Kettle
        <span class="site-header__logo-sub">Coffee Roasters</span>
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__nav-list">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['site-header__nav-link', isCurrent(item.href) && 'is-current']}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* Wrapped so the header grid can place it: the trigger belongs to the
        Svelte island, and this component's scoped styles cannot reach it.
        The drawer and overlay are position:fixed, so nesting costs nothing. */}
    <div class="site-header__actions">
      {/* A link, not an overlay: /search is a real page with its own form, so
          it works without JavaScript and results have a shareable URL. */}
      <a
        href="/search"
        class:list={['site-header__search', isCurrent('/search') && 'is-current']}
        aria-current={isCurrent('/search') ? 'page' : undefined}
      >
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5"></circle>
          <path d="m10.5 10.5 3.5 3.5" stroke-linecap="round"></path>
        </svg>
        <span class="site-header__search-label">Search</span>
      </a>

      {/* The one client island. Seeded with whatever the server knew: the real
          cart on SSR routes, null on prerendered ones. */}
      <CartDrawer client:load initialCart={cart} />
    </div>
  </div>
</header>

<style lang="scss">
  @use '../styles/variables' as vars;
  @use '../styles/mixins' as mixins;

  .site-header {
    position: fixed;
    // Directly under the demo banner, which is fixed above it.
    inset-block-start: var(--banner-height);
    inset-inline: 0;
    // Below md the nav drops to a second row rather than disappearing behind a
    // hamburger. Four short links fit a phone width comfortably, and a menu
    // button would need script for something that does not need script.
    // The height itself is --header-height from :root, which `.has-fixed-header`
    // also pads by (via --masthead-height), so the two can never drift apart.
    height: var(--header-height);
    display: flex;
    align-items: center;
    // Solid, deliberately. A backdrop-filter here becomes the containing block
    // for every position:fixed descendant, which traps the cart drawer inside
    // the 76px header instead of letting it span the viewport. The drawer is a
    // child of this element, so the blur has to go. A solid masthead suits the
    // paper ground better anyway.
    background-color: var(--paper);
    border-block-end: 1px solid var(--rule);
    z-index: 100;

    &__inner {
      @include mixins.container;
      display: grid;
      // Mobile: logo and cart on row one, nav spanning row two.
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'logo cart'
        'nav nav';
      align-items: center;
      gap: vars.$spacing-unit * 1.5 vars.$spacing-unit * 2;
      width: 100%;

      @include mixins.respond-to(md) {
        grid-template-columns: auto 1fr auto;
        grid-template-areas: 'logo nav cart';
        gap: vars.$spacing-unit * 2;
      }
    }

    &__logo {
      grid-area: logo;
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      text-decoration: none;
      color: var(--ink);
      justify-self: start;
    }

    // Stepped up once the banner and the search button arrived: at its first
    // size the wordmark read as the smallest thing in the masthead. Phones get
    // a smaller step because the logo shares row one with search and the cart.
    &__logo-mark {
      display: grid;
      place-items: center;
      width: 2rem;
      height: 2rem;
      color: var(--copper);

      @include mixins.respond-to(md) {
        width: 2.25rem;
        height: 2.25rem;
      }

      svg {
        width: 100%;
        height: 100%;
      }
    }

    &__logo-text {
      display: flex;
      flex-direction: column;
      font-family: vars.$font-display;
      font-size: 1.25rem;
      font-weight: 600;
      line-height: 1.05;
      letter-spacing: -0.015em;

      @include mixins.respond-to(md) {
        font-size: 1.375rem;
      }
    }

    &__logo-sub {
      @include mixins.eyebrow;
      font-size: 0.5625rem;
      letter-spacing: 0.22em;
      margin-block-start: 2px;
    }

    &__nav {
      grid-area: nav;
      padding-block-start: vars.$spacing-unit * 1.5;
      border-block-start: 1px solid var(--rule);

      @include mixins.respond-to(md) {
        justify-self: center;
        padding-block-start: 0;
        border-block-start: 0;
      }
    }

    &__nav-list {
      display: flex;
      justify-content: space-between;
      list-style: none;
      margin: 0;
      padding: 0;
      gap: vars.$spacing-unit * 2;

      @include mixins.respond-to(md) {
        justify-content: flex-start;
        gap: vars.$spacing-unit * 4;
      }
    }

    &__actions {
      grid-area: cart;
      justify-self: end;
      display: flex;
      align-items: stretch;
      gap: vars.$spacing-unit;
    }

    // Matches the cart trigger beside it: same border, same small caps, same
    // inverted hover. Icon only on phones, where the header row is tight.
    &__search {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--rule-strong);
      color: var(--ink);
      text-decoration: none;
      @include mixins.eyebrow;
      color: var(--ink);
      transition:
        border-color 0.2s ease,
        background-color 0.2s ease,
        color 0.2s ease;

      svg {
        width: 0.875rem;
        height: 0.875rem;
      }

      &:hover,
      &:focus-visible,
      &.is-current {
        border-color: var(--ink);
        background: var(--ink);
        color: var(--paper);
      }
    }

    &__search-label {
      @include mixins.visually-hidden;

      @include mixins.respond-to(md) {
        position: static;
        width: auto;
        height: auto;
        margin: 0;
        overflow: visible;
        clip: auto;
        white-space: normal;
      }
    }

    &__nav-link {
      @include mixins.eyebrow;
      @include mixins.rule-link(vars.$ink-soft);
      font-size: 0.6875rem;
      padding-block: 0.5rem;

      &:hover,
      &:focus-visible {
        color: var(--ink);
      }

      // The current section keeps its rule drawn.
      &.is-current {
        color: var(--ink);

        &::after {
          transform: scaleX(1);
          background: var(--copper);
        }
      }
    }
  }
</style>
