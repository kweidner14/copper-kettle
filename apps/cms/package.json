{
  "name": "cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Payload CMS 3.x backend, deployable standalone (e.g. Railway) with Postgres + S3-compatible media storage.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:types": "payload generate:types",
    "payload": "payload",
    "seed:pages": "node --env-file=.env --import tsx scripts/seed-pages.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/db-sqlite": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-s3": "3.86.0",
    "graphql": "^16.9.0",
    "next": "15.4.11",
    "payload": "3.86.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.4.11",
    "typescript": "^5.5.0"
  }
}
