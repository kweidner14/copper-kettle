---
import Layout from '../layouts/Layout.astro'

// Left on-demand deliberately. Astro forbids rewriting from an on-demand route
// into a prerendered one — by build time a prerendered page is a static HTML
// file, so there is nothing left for the server to invoke. Marking this
// `prerender = true` turns every `Astro.rewrite('/404')` in the Shopify routes
// into a 500. It still serves as the fallback for unmatched URLs.
---

<Layout title="Not found" description="This page does not exist either." noindex>
  <section class="notfound">
    <div class="notfound__inner">
      <h1 class="notfound__title">This page does not exist either</h1>
      <p class="notfound__text">
        Like the coffee, whatever you were looking for is not here. It may have been
        unpublished, renamed, or never existed in the first place, which around here is the
        usual reason.
      </p>
      <p><a href="/products">Back to the shop</a></p>
    </div>
  </section>
</Layout>


<style lang="scss">
  @use '../styles/mixins' as mixins;
  @use '../styles/variables' as vars;

  .notfound {
    display: grid;
    place-items: center;
    min-height: 60vh;
    padding-block: vars.$spacing-unit * 10;
    text-align: center;

    &__inner {
      @include mixins.container;
      max-width: 34rem;
    }

    &__title {
      font-size: vars.$step-1;
      margin: 0 0 vars.$spacing-unit * 2;
    }

    &__text {
      color: var(--ink-soft);
      margin-block-end: vars.$spacing-unit * 3;
    }

    a {
      @include mixins.eyebrow;
      @include mixins.rule-link(vars.$ink);
    }
  }
</style>
