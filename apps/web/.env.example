# ---------------------------------------------------------------------------
# Shopify Storefront API
# ---------------------------------------------------------------------------
# NOT configured here. Shopify config goes through `astro:env` (see the `env`
# block in astro.config.mjs), which reads from the Cloudflare Workers runtime:
#
#   local dev   -> .dev.vars           (copy .dev.vars.example, gitignored)
#   production  -> wrangler secret put / Cloudflare dashboard
#   non-secrets -> the `vars` block in wrangler.jsonc (committed)
#
# The private Storefront token is declared `access: 'secret'`, so importing it
# into client-side code fails the build instead of leaking it.

# ---------------------------------------------------------------------------
# Payload CMS (content layer — still build-time / static pages)
# ---------------------------------------------------------------------------
# Where the Payload CMS REST API is reachable at BUILD time.
# Local dev: http://localhost:3000
# Production: your deployed Payload URL (e.g. Railway)
PAYLOAD_API_URL=http://localhost:3000

# Canonical public URL of this site, used for canonical tags, sitemap, OG.
PUBLIC_SITE_URL=https://copperkettle.copperfoxlabs.dev

# GA4 measurement ID. Leave blank to disable analytics entirely.
PUBLIC_GA4_ID=

# Client-facing base URL the browser posts contact/newsletter forms to.
# Usually the same as PAYLOAD_API_URL unless you're proxying it.
PUBLIC_PAYLOAD_API_URL=http://localhost:3000
