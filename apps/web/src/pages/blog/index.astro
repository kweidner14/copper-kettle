---
// Content pages come from Payload at build time, so they stay static even
// though the project now defaults to SSR for the Shopify-backed routes.
export const prerender = true

import Layout from '../../layouts/Layout.astro'
import { getPosts } from '../../lib/api'

const posts = await getPosts()
---

<Layout title="Blog" description="Latest posts.">
  <section class="blog-index" data-reveal>
    <div class="blog-index__inner">
      <h1 class="blog-index__title">Blog</h1>

      {posts.length === 0 && <p class="blog-index__hint">No posts published yet.</p>}

      <ul class="blog-index__list">
        {
          posts.map((post) => (
            <li class="blog-index__item">
              <a class="blog-index__link" href={`/blog/${post.slug}`}>
                <h2 class="blog-index__post-title">{post.title}</h2>
                {post.excerpt && <p class="blog-index__excerpt">{post.excerpt}</p>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style lang="scss">
  @use '../../styles/mixins' as mixins;
  @use '../../styles/variables' as vars;

  .blog-index {
    padding-block: vars.$spacing-unit * 6;

    &__inner {
      @include mixins.container;
      max-width: 42rem;
    }

    &__hint {
      color: var(--color-text-muted);
    }

    &__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: vars.$spacing-unit * 4;
    }

    &__link {
      text-decoration: none;
      display: block;

      &:hover .blog-index__post-title,
      &:focus-visible .blog-index__post-title {
        color: var(--color-primary);
      }
    }

    &__excerpt {
      color: var(--color-text-muted);
    }
  }
</style>
