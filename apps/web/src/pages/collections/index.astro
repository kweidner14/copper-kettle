---
import Layout from '../../layouts/Layout.astro'
import { createShopifyApi } from '../../lib/shopify/api'

const shopify = createShopifyApi(Astro)
const collections = await shopify.getCollections()
---

<Layout title="Collections" description="Browse Copper Kettle coffee by collection.">
  <section class="collections">
    <div class="collections__inner">
      <h1 class="collections__title">Collections</h1>

      {
        collections.length === 0 ? (
          <p class="collections__empty">
            No collections are published to the Headless sales channel yet.
          </p>
        ) : (
          <ul class="collections__grid" role="list">
            {collections.map((collection) => (
              <li>
                <a class="collections__card" href={`/collections/${collection.handle}`}>
                  {collection.image ? (
                    <img
                      class="collections__image"
                      src={collection.image.url}
                      alt={collection.image.altText ?? collection.title}
                      width={collection.image.width ?? 600}
                      height={collection.image.height ?? 400}
                      loading="lazy"
                    />
                  ) : (
                    <div class="collections__image collections__image--placeholder" aria-hidden="true" />
                  )}
                  <h2 class="collections__name">{collection.title}</h2>
                  {collection.description && (
                    <p class="collections__blurb">{collection.description}</p>
                  )}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Layout>


<style lang="scss">
  @use '../../styles/mixins' as mixins;
  @use '../../styles/variables' as vars;

  .collections {
    padding-block: vars.$spacing-unit * 7 vars.$spacing-unit * 10;

    &__inner {
      @include mixins.container;
    }

    &__title {
      font-size: vars.$step-1;
      margin: 0 0 vars.$spacing-unit * 4;
      padding-block-end: vars.$spacing-unit * 2;
      border-block-end: 1px solid var(--ink);
    }

    &__empty {
      color: var(--ink-soft);
    }

    &__grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
      gap: vars.$spacing-unit * 5 vars.$spacing-unit * 4;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    &__card {
      display: grid;
      gap: 0.625rem;
      color: inherit;
      text-decoration: none;
    }

    // Landscape here, unlike products. A collection is a place rather than an
    // object, and a wide frame reads as a heading image instead of a portrait.
    &__image {
      width: 100%;
      aspect-ratio: 3 / 2;
      object-fit: cover;
      background: var(--paper-sunk);

      &--placeholder {
        background: var(--paper-sunk);
      }
    }

    &__name {
      font-family: vars.$font-display;
      font-size: 1.25rem;
      font-weight: 500;
      margin: 0;
      padding-block-end: 0.5rem;
      border-block-end: 1px solid var(--rule);
      transition: border-color 0.3s ease;
    }

    &__card:hover &__name,
    &__card:focus-visible &__name {
      border-color: var(--ink);
    }

    &__blurb {
      margin: 0;
      color: var(--ink-soft);
      font-size: 0.9375rem;
    }
  }
</style>
